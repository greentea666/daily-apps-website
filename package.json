{
  "name": "daily-apps-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "check": "python3 scripts/check-seo.py",
    "test": "npm run test:build && npm run test:ui",
    "test:build": "python3 -m unittest discover -s tests -v",
    "test:ui": "node --test tests/ui.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
